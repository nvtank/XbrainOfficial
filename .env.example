# ─────────────────────────────────────────────────────────────
#  XBrain Virtual Office — environment configuration
#  Copy to `.env` (repo root). Every value is optional for local dev.
# ─────────────────────────────────────────────────────────────

# ── Game / API server ──
# Game server port (SERVER_PORT; PORT is also accepted when NODE_ENV=production)
SERVER_PORT=2567
VITE_SERVER_PORT=2567
HOST=0.0.0.0
NODE_ENV=development
# Comma-separated allowed origins for the REST API ( * = any )
CORS_ORIGIN=*
# HMAC secret for guest tokens — MUST be changed in production (openssl rand -hex 32)
AUTH_SECRET=change-me-to-a-long-random-string
# Enables /api/admin/* and the in-app Admin panel (#/admin). Leave empty to disable.
ADMIN_TOKEN=

# Guest account creations per IP per minute (anti-abuse). Raise only for load tests.
GUEST_RATE_LIMIT=15

# ── Office instance ──
OFFICE_ID=xbrain-danang
OFFICE_NAME=XBrain Đà Nẵng
OFFICE_CAPACITY=50
ALLOW_TELEPORT=false
# stop  = standing up ends the work session
# pause = standing up pauses; today's timer resumes on the next sit
WORK_STAND_MODE=stop
# Office timezone offset (minutes) for "today" statistics. Vietnam = 420
TZ_OFFSET_MINUTES=420
# Store chat history in the database (off by default)
CHAT_PERSIST=false

# ── Database (PostgreSQL via Prisma) ──
# When empty, the server uses a local JSON-backed memory store (apps/server/data/dev-db.json).
DATABASE_URL=
# DATABASE_URL=postgresql://xbrain:xbrain@localhost:5432/xbrain?schema=public
# Fail instead of falling back to the memory store when PostgreSQL is unreachable
STRICT_DB=false

# ── Redis (optional, for multiple game-server processes) ──
REDIS_URL=
# REDIS_URL=redis://localhost:6379

# ── Voice: LiveKit SFU (WebRTC). Leave empty to disable voice. ──
# Dev server: `docker compose up livekit` (keys devkey / secret) or `livekit-server --dev`
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Internal HTTP URL the game server uses for LiveKit's RoomService (defaults to LIVEKIT_URL with http)
LIVEKIT_HOST=
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret

# ── Web client (Vite) ──
WEB_PORT=5173
# Game server URL used by the browser. Empty = same host as the page, port $PORT (dev)
VITE_SERVER_URL=
# Optional custom logo (PNG/SVG/WebP for 2D + extruded 3D sign, or a .glb model)
VITE_LOGO_URL=/assets/xbrain-logo.webp

# ── Production: serve the built web client from the game server ──
SERVE_WEB=
